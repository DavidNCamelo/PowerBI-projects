			partition Calendario = calculated
				mode: import
				source = ```
						ADDCOLUMNS (
						CALENDAR ( DATE( YEAR ( MIN (transporte[FECHA_DESPACHO])), 08, 01), DATE( YEAR( MAX( transporte[FECHA_DESPACHO]) ), 12, 31 ) ),
						"Año", YEAR( [Date]),
						"#Mes", MONTH ( [Date] ),
						"#Día", DAY ( [Date] ),
						"Trimestre", "T" & FORMAT ( [Date], "Q" ), 
						"Mes", FORMAT ( [Date], "MMMM" ),
						"Día", FORMAT ( [Date], "DDDD" ),
						"AñoTrimestre", FORMAT ( [Date], "YYYY" ) & "-T" & FORMAT ( [Date], "Q" ) )
						```

			annotation PBI_Id = 4d3b712c8d244b738501ef9e721fc253

		table Medidas
			lineageTag: 6ce62c5e-cd08-42c7-9d04-3956624c04bf

			measure acumulado_despachos_por_departamentos = ```
					
					    VAR Total_Despachos = SUM(transporte[DESPACHOS])
					    VAR Ranking = 
					    RANKX(
					        ALL(transporte[Origen.Departamento]), CALCULATE([total_despachos])
					    )
					    VAR Acumulado =
					    SUMX(
					    TOPN(Ranking, ALL(transporte[Origen.Departamento]),CALCULATE([total_despachos]), DESC),
					    CALCULATE([total_despachos])
					    )
					    
					RETURN Acumulado
					```
				formatString: 0
				lineageTag: 28fa9c58-aebe-4188-9ecc-4b9818053775

			measure total_despachos = SUM(transporte[DESPACHOS])
				formatString: #,0
				lineageTag: 42252f7c-f7f8-418d-b673-d7734f57c51d

			measure total_despachos_general = ```
					
					    SUMX(
					        ALL(transporte[Origen.Departamento]), [total_despachos])
					```
				formatString: #,0
				lineageTag: c3f7c358-777c-4947-a7d6-a0e6ec373162

			measure porcentaje_acum_despachos_por_departamentos = DIVIDE([acumulado_despachos_por_departamentos],[total_despachos_general],0)
				formatString: 0.00\ %;-0.00\ %;0.00\ %
				lineageTag: f68e39e9-2086-4b62-be78-dc5948442b3a

			measure despachos_periodo_anterior =
					
					CALCULATE([total_despachos], DATEADD(Calendario[Date], -1,YEAR))
				formatString: 0
				lineageTag: abfa5011-5ca2-42db-84ee-b5fcd521c10b

			measure variacion_anual_despachos = ```
					
					VAR Despacho_A_Anterior = 
					    CALCULATE([total_despachos], DATEADD(Calendario[Date], -1, YEAR))
					
					RETURN 
					    IF(
					        ISBLANK(Despacho_A_Anterior) || Despacho_A_Anterior = 0,
					        BLANK(),
					        DIVIDE(([total_despachos] - Despacho_A_Anterior), Despacho_A_Anterior,2)
					    )
					```
				formatString: 0.00\ %;-0.00\ %;0.00\ %
				lineageTag: 0f34426b-a9e2-4907-aa78-a3b8b1b3299b

			measure total_pasajeros = SUM(transporte[PASAJEROS])
				formatString: #,0
				lineageTag: 90da7bdb-5cd2-4be5-8e1e-6f2ba6c3f066

			measure variacion_anual_pasajeros = ```
					
					VAR Pasajeros_A_Anterior = 
					    CALCULATE([total_pasajeros], DATEADD(Calendario[Date], -1, YEAR))
					
					RETURN 
					    IF(
					        ISBLANK(Pasajeros_A_Anterior) || Pasajeros_A_Anterior = 0,
					        BLANK(),
					        DIVIDE(([total_pasajeros] - Pasajeros_A_Anterior),Pasajeros_A_Anterior,2)
					    )
					```
				formatString: 0.00\ %;-0.00\ %;0.00\ %
				lineageTag: ecb7b171-740e-4bf7-8722-1fd9f9a329b4

			measure variacion_trimestral_despachos = ```
					
					VAR Despacho_T_Anterior = 
					    CALCULATE([total_despachos], DATEADD(Calendario[Date], -1, QUARTER))
					
					RETURN 
					    IF(
					        ISBLANK(Despacho_T_Anterior)|| Despacho_T_Anterior = 0,
					        BLANK(),
					        DIVIDE(([total_despachos] - Despacho_T_Anterior), Despacho_T_Anterior,2)
					    )
					```
				formatString: 0.00\ %;-0.00\ %;0.00\ %
				lineageTag: 5b3e9460-fcec-4452-8d8c-7e92fb0a3fe1

			measure variacion_trimestral_pasajeros = ```
					
					VAR Pasajeros_T_Anterior = 
					    CALCULATE([total_pasajeros], DATEADD(Calendario[Date], -1, QUARTER))
					
					RETURN 
					    IF(
					        ISBLANK(Pasajeros_T_Anterior) || Pasajeros_T_Anterior = 0,
					        BLANK(),
					        DIVIDE(([total_pasajeros] - Pasajeros_T_Anterior), Pasajeros_T_Anterior,2)
					    )
					```
				formatString: 0.00\ %;-0.00\ %;0.00\ %
				lineageTag: 34c8ed15-63f5-479b-b4bf-dd72b176beb5

			measure acumulado_pasajeros_por_departamento_destino = ```
					
					    VAR Ranking = 
					    RANKX(
					        ALL(transporte[Destino.Departamento]),
					        [total_pasajeros]
					    )
					    VAR AcumuladoP =
					    SUMX(
					        TOPN(Ranking, ALL(transporte[Destino.Departamento]),
					            [total_pasajeros],
					            DESC
					        ),
					        [total_pasajeros]
					    )
					    
					RETURN AcumuladoP
					```
				formatString: 0
				lineageTag: 6cbaa858-6866-421d-852e-e467167c28b4

