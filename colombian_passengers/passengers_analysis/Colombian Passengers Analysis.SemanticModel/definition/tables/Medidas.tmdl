	measure acumulado_pasajeros_por_departamento_destino = ```
			
			    VAR Ranking = 
			    RANKX(
			        ALL(municipiosDestino[departamento]),
			        [total_pasajeros]
			    )
			    VAR AcumuladoP =
			    SUMX(
			        TOPN(Ranking, ALL(municipiosDestino[departamento]),
			            [total_pasajeros],
			            DESC
			        ),
			        [total_pasajeros]
			    )
			    
			RETURN AcumuladoP
			```
		formatString: 0
		lineageTag: 6cbaa858-6866-421d-852e-e467167c28b4

	measure total_pasajeros_general = ```
			
			    SUMX(
			        ALL(transporte), [total_pasajeros])
			```
		formatString: #,0
		lineageTag: 47c47a61-c060-42da-b91b-062e1c75d94f

	measure porcentaje_acum_pasajeros_por_departamento_destino = DIVIDE([acumulado_pasajeros_por_departamento_destino],[total_pasajeros_general],0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ade9e413-8f90-484d-8cf5-aa79970726f8

	measure total_mun_destino =
			VAR _codes = VALUES(transporte[MUNICIPIO_DESTINO_RUTA])
			RETURN
			CALCULATE(
				DISTINCTCOUNT(municipiosDestino[codigo_municipio]),
				TREATAS(_codes, municipiosDestino[codigo_municipio])
			)
		formatString: #,0
		lineageTag: 4720387a-7fc0-4e8f-8a38-04d07b105721

