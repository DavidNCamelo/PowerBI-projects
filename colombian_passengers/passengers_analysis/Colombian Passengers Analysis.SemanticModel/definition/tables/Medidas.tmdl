		lineageTag: ecb7b171-740e-4bf7-8722-1fd9f9a329b4

	measure variacion_trimestral_despachos = ```
			
			VAR Despacho_T_Anterior = 
			    CALCULATE([total_despachos], DATEADD(Calendario[Date], -1, QUARTER))
			
			RETURN 
