table Medidas
	lineageTag: 6ce62c5e-cd08-42c7-9d04-3956624c04bf

	measure acumulado_despachos_por_departamentos = ```
			
			    VAR Total_Despachos = SUM(transporte[DESPACHOS])
			    VAR Ranking = 
			    RANKX(
			        ALL(municipiosOrigen[departamento]), CALCULATE([total_despachos])
			    )
			    VAR Acumulado =
			    SUMX(
			    TOPN(Ranking, ALL(municipiosOrigen[departamento]),CALCULATE([total_despachos]), DESC),
			    CALCULATE([total_despachos])
			    )
			    
			RETURN Acumulado
			```
		formatString: 0
		lineageTag: 28fa9c58-aebe-4188-9ecc-4b9818053775

	measure total_despachos = SUM(transporte[DESPACHOS])
		formatString: #,0
		lineageTag: 42252f7c-f7f8-418d-b673-d7734f57c51d

	measure total_despachos_general = ```
			
			    SUMX(
			        ALL(transporte[MUNICIPIO_ORIGEN_RUTA]), [total_despachos])
			```
		formatString: #,0
		lineageTag: c3f7c358-777c-4947-a7d6-a0e6ec373162

	measure porcentaje_acum_despachos_por_departamentos = DIVIDE([acumulado_despachos_por_departamentos],[total_despachos_general],0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: f68e39e9-2086-4b62-be78-dc5948442b3a

	measure despachos_periodo_anterior =
			
			CALCULATE([total_despachos], DATEADD(Calendario[Date], -1,YEAR))
		formatString: 0
		lineageTag: abfa5011-5ca2-42db-84ee-b5fcd521c10b

	measure variacion_anual_despachos = ```
			
			VAR Despacho_A_Anterior = 
			    CALCULATE([total_despachos], DATEADD(Calendario[Date], -1, YEAR))
			
			RETURN 
			    IF(
			        ISBLANK(Despacho_A_Anterior) || Despacho_A_Anterior = 0,
			        BLANK(),
			        DIVIDE(([total_despachos] - Despacho_A_Anterior), Despacho_A_Anterior,2)
			    )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0f34426b-a9e2-4907-aa78-a3b8b1b3299b

	measure total_pasajeros = SUM(transporte[PASAJEROS])
