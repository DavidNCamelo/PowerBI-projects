	partition Calendario = calculated
		mode: import
		source = ```
				ADDCOLUMNS (
				CALENDAR ( DATE( YEAR ( MIN (transporte[fecha_despacho])), 08, 01), DATE( YEAR( MAX( transporte[fecha_despacho]) ), 12, 31 ) ),
				"Año", YEAR( [Date]),
				"#Mes", MONTH ( [Date] ),
				"#Día", DAY ( [Date] ),
				"Trimestre", "T" & FORMAT ( [Date], "Q" ), 
				"Mes", FORMAT ( [Date], "MMMM" ),
				"Día", FORMAT ( [Date], "DDDD" ),
				"AñoTrimestre", FORMAT ( [Date], "YYYY" ) & "-T" & FORMAT ( [Date], "Q" ) )
				```

	annotation PBI_Id = 4d3b712c8d244b738501ef9e721fc253

