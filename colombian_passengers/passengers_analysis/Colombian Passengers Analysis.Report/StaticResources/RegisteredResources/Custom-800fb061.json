{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "Custom-800fb061.json",
  "dataColors": [
    "#0072B2",
    "#009E73",
    "#D55E00",
    "#CC79A7",
    "#332288",
    "#117733",
    "#882255",
    "#666666"
  ],
  "background": "#F1F5F9",
  "foreground": "#0F172A",
  "tableAccent": "#0F766E",
  "good": "#137C55",
  "neutral": "#A16207",
  "bad": "#B42318",
  "minimum": "#E8F1F5",
  "center": "#CBD5E1",
  "maximum": "#0072B2",
  "null": "#9CA3AF",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 18,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8E1EA"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "bold": true,
            "$id": "default"
          }
        ],
        "label": [
          {
            "show": true,
            "$id": "default"
          }
        ],
        "cardCalloutArea": [
          {
            "paddingUniform": 0
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ]
      }
    }
  }
}