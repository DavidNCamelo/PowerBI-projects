table Measures_
	lineageTag: 7d78a5ab-93f7-4786-915f-ae61f3d14546

	/// Global medals won by NOC
	measure 'Total Gobal Medals' = SUM('Olympic Prizes'[Global Medals])
		formatString: #,0
		displayFolder: Medals By Country General View
		lineageTag: 870186d3-873e-48f7-adab-a83ba9b7286e

	/// Medals won by Athlete
	measure 'Total Medals by Athlete' = SUM('Olympic medalists'[Medals by Athlete])
		formatString: #,0
		displayFolder: Medals by Athletes
		lineageTag: a46e8e55-c131-4ece-9b57-ab0dc5231e0f

	/// Gold medals won by NOC
	measure 'Gold Medals By NOC' = ```
			
			VAR gold = 
			    CALCULATE(
			        [Total Gobal Medals],
			        'Olympic Prizes'[Medal Type by Country] = "Gold"
			    )
			
			RETURN
			IF(
			    ISBLANK(gold),
			    0,
			    gold
			)
			```
		formatString: #,0
		displayFolder: Medals By Country General View
		lineageTag: f6a8253e-7780-42d9-ab60-35a83aea3575

	/// Bronze medals won by NOC
	measure 'Bronze Medals By NOC' = ```
			
			VAR bronze = 
			    CALCULATE(
			        [Total Gobal Medals],
			        'Olympic Prizes'[Medal Type by Country] = "Bronze"
			    )
			
			RETURN
			IF(
			    ISBLANK(bronze),
			    0,
			    bronze
			)
			```
		formatString: #,0
		displayFolder: Medals By Country General View
		lineageTag: 4255fae2-92ab-4cb4-b43c-8544c47fbb3e

