	measure 'Gold Medals By Athlete' = ```
			
			VAR gold = 
			    CALCULATE(
			        [Total Medals by Athlete],
			        'Olympic medalists'[Medal type by Athlete] = "Gold"
			    )
			
			RETURN
			IF(
			    ISBLANK(gold),
			    0,
			    gold
			)
			```
		formatString: #,0
		displayFolder: Medals by Athletes
		lineageTag: 2c01461e-24b9-4ab1-8d6d-7e2417528431

