                      }
                    },
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": " Winter Editions (held since ﻿1924﻿). The events have taken place in ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": {
                      "propertyIdentifier": {
                        "objectName": "values",
