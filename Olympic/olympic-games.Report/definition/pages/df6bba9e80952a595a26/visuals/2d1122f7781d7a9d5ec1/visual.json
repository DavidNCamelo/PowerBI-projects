                    "value": {
                      "propertyIdentifier": {
                        "objectName": "values",
                        "propertyName": "expr"
                      },
                      "selector": {
                        "id": "Valor 2"
                      }
                    },
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": " Modern Olympic Editions: ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
