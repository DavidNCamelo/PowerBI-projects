      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "We know that the modern Olympic Games capture global attention every four years, while the Winter Olympic Games tend to draw interest primarily from participating committees. However, accessing all the data in a single, free resource remains a challenge.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "center"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This is an attempt to provide a general overview of some of the results we've typically seen in the news and event coverage while the games are happening live.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "center"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Since ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": {
                      "propertyIdentifier": {
                        "objectName": "values",
                        "propertyName": "expr"
                      },
                      "selector": {
                        "id": "Valor"
                      }
                    },
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": ", there have been ",
